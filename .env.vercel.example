# Reference only: set these in Vercel Project Settings > Environment Variables.
PROCESSING_MODE=serverless
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
STORAGE_DIR=/tmp/certificates
S3_BUCKET=certificates
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=replace-with-r2-access-key
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-key
AWS_DEFAULT_REGION=auto
PROCESSING_BATCH_SIZE=10
MAX_RECIPIENTS_PER_JOB=100
MAX_UPLOAD_BYTES=3000000
